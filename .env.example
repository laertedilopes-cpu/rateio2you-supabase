# =========================================================
# rateio2you — variáveis de ambiente do servidor
# ---------------------------------------------------------
# Copie este arquivo para .env (ou cole as variáveis no painel
# da Vercel em Settings → Environment Variables).
# NUNCA coloque estas chaves no config.js nem no GitHub.
# =========================================================

# ---------- Supabase (obrigatório) ----------
# Project URL: Supabase → Project Settings → API → Project URL
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (anon). Também vai no assets/js/config.js.
SUPABASE_ANON_KEY=

# Chave secreta (service_role). Só existe no servidor.
# Supabase → Project Settings → API → service_role (reveal).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Site ----------
# Ex.: https://rateio2you.vercel.app (sem barra no final)
PUBLIC_SITE_URL=

# ---------- Banco Inter • Pix automático ----------
# Produção:   https://cdpj.partners.bancointer.com.br
# Sandbox:    https://cdpj-sandbox.partners.bancointer.com.br
# (Se INTER_API_BASE ficar vazio, o sistema escolhe pela INTER_ENV.)
INTER_ENV=producao
INTER_API_BASE=

# Credenciais do aplicativo Pix no portal do Banco Inter.
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=

# Chave Pix cadastrada na conta PJ do Inter (CNPJ, e-mail, telefone ou aleatória).
INTER_PIX_KEY=

# Certificado e chave em base64 (veja o GUIA-BANCO-INTER.md).
# Forma 1: certificado + chave separados em PEM, convertidos para base64.
INTER_CERT_B64=
INTER_KEY_B64=

# Forma 2 (alternativa): arquivo .pfx/.p12 inteiro em base64.
INTER_PFX_B64=
INTER_PFX_PASSWORD=

# ---------- Segurança ----------
# Token que o Inter envia no final da URL do webhook.
# Ex.: https://SEU-SITE/api/pix/webhook?token=ESTE_TOKEN
INTER_WEBHOOK_TOKEN=

# Token para chamar /api/pix/register-webhook manualmente.
# Gere algo longo e aleatório (ex.: 40 letras/números).
ADMIN_TOKEN=
